# Kopioi tämä tiedosto nimelle .env (projektin juureen tai backend-kansioon). Ei lainausmerkkejä, ei kommentteja arvon perässä.
# Ilmainen avain: https://the-odds-api.com
ODDS_API_KEY=
ODDS_REGIONS=eu
# h2h = moneyline (1 kredit/kysely). Lisää ,h2h_3_way vain jos tarjoaja tukee sitä NHL:lle.
ODDS_MARKETS=h2h
SCHEDULER_ENABLED=true
REFRESH_MINUTES=30
ODDS_MAX_AGE_MINUTES=60
ODDS_MIN_INTERVAL_MINUTES=240
CLOSING_CAPTURE=false
CLV_REFERENCE_PROVIDER=pinnacle
MIN_GAMES_PER_TEAM=8
MIN_EV_PCT=3.0
MIN_SETTLED_FOR_VALIDATION=300
BACKFILL_FROM=2025-10-01
# OddsPapi (valinnainen toinen kerroinlähde, ilmainen kehittäjäavain: https://oddspapi.io)
ODDSPAPI_KEY=
# Pilkuilla erotettu lista pidettävistä kirjoista, tyhjä = kaikki (esim. pinnacle,bet365). Näet nähdyt kirjat /api/health-vastauksesta.
ODDSPAPI_BOOKMAKERS=
