package fi.nhl.analytics.web;

import fi.nhl.analytics.domain.GameEntity;
import fi.nhl.analytics.domain.GameState;
import fi.nhl.analytics.domain.Repos.*;
import fi.nhl.analytics.provider.OddsProvider;
import fi.nhl.analytics.service.*;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.time.Instant;
import java.time.LocalDate;
import java.time.format.DateTimeParseException;
import java.util.*;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.multipart.MultipartFile;

@RestController
@RequestMapping("/api")
public class ApiController {
    private final GameRepo games; private final MarketService market; private final RefreshService refresh;
    private final AnalyticsService analytics; private final List<OddsProvider> providers;
    private final ClvService clv; private final ImportService imports; private final TeamXgRepo xgRepo;

    public ApiController(GameRepo g, MarketService m, RefreshService r, AnalyticsService a, List<OddsProvider> p,
                         ClvService clv, ImportService imports, TeamXgRepo xgRepo) {
        this.clv = clv; this.imports = imports; this.xgRepo = xgRepo;
        this.games = g; this.market = m; this.refresh = r; this.analytics = a; this.providers = p;
    }

    @GetMapping("/health")
    public Map<String, Object> health() {
        Map<String, Object> m = new LinkedHashMap<>();
        m.put("status", "UP"); m.put("serverTime", Instant.now()); m.put("games", games.count());
        m.put("refreshRunning", refresh.isRunning());
        Map<String, Object> last = refresh.lastReport();
        m.put("lastRefresh", last);
        m.put("dataWarning", last == null ? "No refresh has completed since startup; showing stored data only"
                : Boolean.TRUE.equals(last.get("ok")) ? null : "Last refresh had failed stages; data may be incomplete");
        List<Map<String, Object>> ps = new ArrayList<>();
        ps.add(Map.of("id", "nhl-web-api", "state", last == null ? "UNKNOWN" : stageState(last, "schedule_and_results")));
        for (OddsProvider p : providers) ps.add(Map.of("id", p.id(), "state", p.status().state(), "detail", p.status().detail()));
        m.put("providers", ps);
        return m;
    }

    private static String stageState(Map<String, Object> report, String name) {
        for (Object o : (List<?>) report.get("stages")) { Map<?, ?> s = (Map<?, ?>) o; if (name.equals(s.get("stage"))) return String.valueOf(s.get("status")); }
        return "UNKNOWN";
    }

    @GetMapping("/games")
    public List<Map<String, Object>> games(@RequestParam(defaultValue = "SCHEDULED") String state) {
        GameState gs;
        try { gs = GameState.valueOf(state.toUpperCase()); } catch (IllegalArgumentException e) { throw new BadRequest("Unknown state: " + state); }
        List<Map<String, Object>> out = new ArrayList<>();
        for (GameEntity g : games.findByStateOrderByStartUtc(gs)) if (gs != GameState.FINAL || out.size() < 100) out.add(market.gameInfo(g));
        return out;
    }

    @GetMapping("/predictions/moneyline") public List<Map<String, Object>> moneyline() { return market.upcoming("MONEYLINE"); }
    @GetMapping("/predictions/regulation") public List<Map<String, Object>> regulation() { return market.upcoming("REG_1X2"); }
    @GetMapping("/combinations")
    public List<Map<String, Object>> combinations(@RequestParam(defaultValue = "2") int maxLegs) {
        if (maxLegs < 2 || maxLegs > 3) throw new BadRequest("maxLegs must be 2 or 3");
        return market.combinations(maxLegs);
    }

    @GetMapping("/lineups")
    public Map<String, Object> lineups() {
        return Map.of("items", List.of(), "status", "NOT_AVAILABLE",
                "detail", "No lineup, injury or goalie source is integrated. All goalie/injury status is UNKNOWN and not used by the model.");
    }

    @GetMapping("/stats/summary") public Map<String, Object> summary() { return analytics.summary(); }

    @GetMapping("/stats/accuracy")
    public Map<String, Object> accuracy(@RequestParam(required = false) String from, @RequestParam(required = false) String to) {
        return analytics.accuracy(date(from), date(to));
    }

    @GetMapping("/history")
    public List<Map<String, Object>> history(@RequestParam(required = false) String from, @RequestParam(required = false) String to,
                                             @RequestParam(defaultValue = "100") int limit, @RequestParam(defaultValue = "ALL") String status) {
        if (limit < 1 || limit > 500) throw new BadRequest("limit must be 1-500");
        String st = status.toUpperCase();
        if (!List.of("ALL", "SETTLED", "PENDING", "VOID").contains(st)) throw new BadRequest("status must be ALL, SETTLED, PENDING or VOID");
        return analytics.history(date(from), date(to), limit, st);
    }

    @GetMapping("/suggestions") public Map<String, Object> suggestions() { return market.suggestions(); }

    @PostMapping("/refresh")
    public ResponseEntity<Map<String, Object>> doRefresh() {
        try { return ResponseEntity.ok(refresh.refresh()); }
        catch (IllegalStateException busy) { return ResponseEntity.status(HttpStatus.CONFLICT).body(Map.of("error", busy.getMessage())); }
    }

    @PostMapping("/backtest")
    public ResponseEntity<?> backtest(@RequestParam(defaultValue = "100") int warmup) {
        if (warmup < 20 || warmup > 2000) throw new BadRequest("warmup must be 20-2000");
        try { return ResponseEntity.ok(analytics.backtest(warmup)); }
        catch (IllegalStateException busy) { return ResponseEntity.status(HttpStatus.CONFLICT).body(Map.of("error", busy.getMessage())); }
    }

    @GetMapping("/clv") public Map<String, Object> clv() { return clv.report(); }

    @GetMapping("/xg")
    public List<fi.nhl.analytics.domain.TeamXgEntity> xg() {
        List<fi.nhl.analytics.domain.TeamXgEntity> l = new ArrayList<>(xgRepo.findAll());
        l.sort(Comparator.comparingInt((fi.nhl.analytics.domain.TeamXgEntity x) -> x.season).reversed().thenComparing(x -> x.team));
        return l;
    }

    @PostMapping("/backtest/market")
    public ResponseEntity<?> marketBacktest(@RequestParam(defaultValue = "100") int warmup, @RequestParam(defaultValue = "3.0") double minEv,
                                            @RequestParam(defaultValue = "pinnacle") String source) {
        if (warmup < 20 || warmup > 2000) throw new BadRequest("warmup must be 20-2000");
        if (minEv < 0 || minEv > 50) throw new BadRequest("minEv must be 0-50 (percent)");
        try { return ResponseEntity.ok(analytics.marketBacktest(warmup, minEv, source)); }
        catch (IllegalStateException busy) { return ResponseEntity.status(HttpStatus.CONFLICT).body(Map.of("error", busy.getMessage())); }
    }

    public record ManualOdds(Long gameId, String market, String provider, Double home, Double draw, Double away) {}

    @PostMapping("/odds/manual")
    public Map<String, Object> manualOdds(@RequestBody ManualOdds b) {
        if (b == null || b.gameId() == null) throw new BadRequest("gameId is required");
        try { return imports.manualOdds(b.gameId(), b.market(), b.provider(), b.home(), b.draw(), b.away()); }
        catch (IllegalArgumentException e) { throw new BadRequest(e.getMessage()); }
    }

    @PostMapping("/import/odds")
    public Map<String, Object> importOdds(@RequestParam("file") MultipartFile file, @RequestParam(defaultValue = "american") String format,
                                          @RequestParam(defaultValue = "pinnacle") String source) throws IOException {
        if (file.isEmpty()) throw new BadRequest("File is empty");
        if (!format.equals("american") && !format.equals("decimal")) throw new BadRequest("format must be american or decimal");
        try { return imports.importOdds(new String(file.getBytes(), StandardCharsets.UTF_8), format.equals("american"), source); }
        catch (IllegalArgumentException e) { throw new BadRequest(e.getMessage()); }
    }

    @PostMapping("/import/xg")
    public Map<String, Object> importXg(@RequestParam("file") MultipartFile file, @RequestParam(required = false) Integer season,
                                        @RequestParam(defaultValue = "csv-upload") String source) throws IOException {
        if (file.isEmpty()) throw new BadRequest("File is empty");
        try { return imports.importXg(new String(file.getBytes(), StandardCharsets.UTF_8), season, source); }
        catch (IllegalArgumentException e) { throw new BadRequest(e.getMessage()); }
    }

    private static LocalDate date(String s) {
        if (s == null || s.isBlank()) return null;
        try { return LocalDate.parse(s); } catch (DateTimeParseException e) { throw new BadRequest("Invalid date (use yyyy-MM-dd): " + s); }
    }

    static class BadRequest extends RuntimeException { BadRequest(String m) { super(m); } }

    @ExceptionHandler(BadRequest.class)
    public ResponseEntity<Map<String, Object>> bad(BadRequest e) { return ResponseEntity.badRequest().body(Map.of("error", e.getMessage())); }

    /** Never leak stack traces to clients. */
    @ExceptionHandler(Exception.class)
    public ResponseEntity<Map<String, Object>> fail(Exception e) {
        org.slf4j.LoggerFactory.getLogger(ApiController.class).error("Unhandled API error", e);
        return ResponseEntity.status(500).body(Map.of("error", "Internal error (" + e.getClass().getSimpleName() + "); see server log"));
    }
}

    @GetMapping("/api/matchday-plan") public java.util.Map<String,Object> matchdayPlan(@org.springframework.web.bind.annotation.RequestParam(required=false) String date) { try { return matchday.plan(date==null||date.isBlank()?null:java.time.LocalDate.parse(date)); } catch(Exception e){ throw new BadRequest(e.getMessage()); } 
    @GetMapping("/api/matchday-plan") public java.util.Map<String,Object> matchdayPlan(@org.springframework.web.bind.annotation.RequestParam(required=false) String date) { try { return matchday.plan(date==null||date.isBlank()?null:java.time.LocalDate.parse(date)); } catch(Exception e){ throw new BadRequest(e.getMessage()); } }
}

